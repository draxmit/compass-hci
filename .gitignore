# Compass setup scratch (NEVER commit — contains config values during Phase 0 setup)
.compass-setup-scratch.md
.env
.env.local
.env.*.local
google-services.json
app/google-services.json
GoogleService-Info.plist
*-firebase-adminsdk-*.json

# Monorepo
app/node_modules
app/.expo
app/dist
app/web-build

# Firebase CLI cache (per-machine deploy state, never commit)
.firebase/

# Generated DOCX/PNG outputs from `pnpm docs:export` — regenerated
# on demand, not source of truth.
dist-docs/
app/.env.local
app/ios
app/android
packages/*/node_modules
packages/*/dist

# Runtime / IDE state
.claude/scheduled_tasks.lock
app/.claude/

# Internal tooling not part of the shipped app:
# .claude/  → Claude Code orchestrator memory + agent prompts
# legacy/   → archived Vite prototype (kept locally as reference, never deployed)
# scripts/export-docs.mjs → class-deliverable DOCX/PNG generator (run locally for submission)
# docs/decisions/, docs/changes/, docs/CHANGELOG.md → internal dev-process notes (ADRs + per-task summaries + merge log)
.claude/
legacy/
scripts/export-docs.mjs
docs/decisions/
docs/changes/
docs/CHANGELOG.md
